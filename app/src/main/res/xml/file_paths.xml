<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Report PDFs are written to cacheDir/reports and shared read-only via FileProvider. -->
    <cache-path name="reports" path="reports/" />
    <!-- Downloaded update APKs live in cacheDir/updates and are handed to the system installer. -->
    <cache-path name="updates" path="updates/" />
    <!-- A photo taken to scan a reading (see ocr/) lives in cacheDir/ocr while it's recognised. -->
    <cache-path name="ocr" path="ocr/" />
</paths>
