<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12+. Same coverage for cloud backup and device-to-device
     transfer: the readings/notes database plus user settings. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="bp-tracker.db" />
        <include domain="sharedpref" path="backup_prefs.xml" />
        <include domain="sharedpref" path="reminder_prefs.xml" />
        <include domain="sharedpref" path="theme_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="bp-tracker.db" />
        <include domain="sharedpref" path="backup_prefs.xml" />
        <include domain="sharedpref" path="reminder_prefs.xml" />
        <include domain="sharedpref" path="theme_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
